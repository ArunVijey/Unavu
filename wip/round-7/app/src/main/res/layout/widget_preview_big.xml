<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (API 31+) for the big widget: the same layout as the live Glance widget, with sample numbers.
     Colours follow the phone's day/night mode (colors_r7e.xml). Only RemoteViews-safe views are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/a_widget_still_eat"
        android:textColor="@color/r7e_widget_ink2"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/r7e_widget_preview_left"
            android:textColor="@color/r7e_widget_ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/r7e_widget_preview_detail"
            android:textColor="@color/r7e_widget_ink2"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="58"
        android:progressDrawable="@drawable/widget_preview_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_pill_acc"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/a_widget_log_food"
            android:textColor="@color/r7e_widget_on_acc"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_pill"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/a_widget_water"
            android:textColor="@color/r7e_widget_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
